---
// The history view (milestone 5): the DAG list beside #empty/#doc — main
// spine at indent 0, undo-* branch commits one level in, "you are here"
// on HEAD. A node click opens the preview panel below the list (message,
// time, changed files); a file click previews the content read-only via
// /api/git/show. The panel holds the two restores: fetch file (one file,
// light) and make master (whole tree, dangerous, confirmed).
---
<div class="empty" id="history" hidden>
  <div class="doc-col">
    <header class="doc-head"><h1>History</h1></header>
    <div class="md-body">
      <ul class="hist-list" id="hist-list"></ul>
      <div id="hist-preview" hidden>
        <p class="hist-msg" id="hist-msg"></p>
        <p class="hist-time" id="hist-time"></p>
        <ul class="hist-files" id="hist-files"></ul>
        <div class="md-body hist-body" id="hist-body" hidden></div>
        <div class="confirm-row hist-actions">
          <button type="button" id="hist-restore" disabled>fetch file</button>
          <button type="button" class="confirm-ok" id="hist-master">make master</button>
        </div>
      </div>
    </div>
  </div>
</div>
