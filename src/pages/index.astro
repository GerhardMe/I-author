---
import Base from '../layouts/base.astro';
import Sidebar from '../components/Sidebar.astro';
import DocView from '../components/DocView.astro';
import NewDialog from '../components/NewDialog.astro';
import { loadSecrets } from '../lib/auth/secrets.ts';
// pre-setup the app is open and the footer offers the setup path instead of
// the session buttons (owner decision 2026-10-09 — same behaviour everywhere)
const authReady = loadSecrets() !== null;
---
<Base title="I author">
  <div class="app">
    <Sidebar authReady={authReady} />
    <main class="main">
      <DocView />
    </main>
  </div>
  <script is:inline>
    // pre-paint nav state: on mobile the overlay starts closed so the page is
    // never covered by a flash before the app script runs; desktop starts
    // open, which the static markup already is
    if (matchMedia('(max-width: 900px)').matches) {
      document.querySelector('.app').classList.add('nav-off');
    }
  </script>
  <NewDialog />
</Base>
<script>
  // the whole app shell: boot() plus the feature modules under src/app/ —
  // the document-level listeners whose registration order is load-bearing
  // (Escape precedence, click-to-dismiss) live in main.ts
  import { boot } from '../app/main.ts';
  boot();
</script>
