---
import '@fontsource-variable/literata';
import '../styles/global.css';

interface Props {
  title?: string;
  // bare screens (login/setup) have no title bar to host the toggle — they
  // keep the old floating button; the app shell renders its own in .side-head
  fixedTheme?: boolean;
}

const { title = 'I author', fixedTheme = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body>
    {fixedTheme && (
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">◐</button>
    )}
    <slot />
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        // suspend the transitions for the flip (double rAF waits for the new
        // theme to paint), so the theme change is one hard cut
        document.body.classList.add('theme-switching');
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.body.classList.remove('theme-switching')),
        );
      });
    </script>
  </body>
</html>