#!/usr/bin/env bash
# Deploy Iauthor to the VPS: test + build locally (the app is standalone:
# dist needs no node_modules at runtime), sync source + dist, restart, health
# check. The server runs everything through the flake (scripts/serve), so it
# needs no hand-installed node/pnpm/texlive.
set -euo pipefail
cd "$(dirname "$0")/.."

SERVER=${IAUTHOR_SERVER:-server}
ROOT=${IAUTHOR_ROOT:-serverRoot}
APP_DIR=${IAUTHOR_APP_DIR:-/home/server/iauthor}
URL=${IAUTHOR_URL:-https://write.gerhard.page}
DOMAIN=${IAUTHOR_DOMAIN:-write.gerhard.page}

say() { printf '\n==> %s\n' "$*"; }

# run pnpm under nix develop when it is not on PATH
run() {
  if command -v pnpm >/dev/null 2>&1; then "$@"; else nix develop -c "$@"; fi
}

say "tests"
run pnpm test

say "pre-flight local build (IAUTHOR_DOMAINS is baked in at build time)"
rm -rf dist
IAUTHOR_DOMAINS=$DOMAIN run pnpm build

say "syncing source to $SERVER:$APP_DIR"
rsync -az --delete \
  --exclude node_modules --exclude .astro --exclude dist --exclude secrets \
  --exclude .git --exclude .env \
  ./ "$SERVER:$APP_DIR/"

say "syncing dist"
rsync -az --delete dist/ "$SERVER:$APP_DIR/dist/"

say "warming the nix runtime on the server (pins node + texlive closures)"
# downloads the exact store paths from cache.nixos.org; registers a gcroot
# so `nix store gc` can never break the running service
ssh "$SERVER" "set -e; cd $APP_DIR
  if [ ! -e .gcroot ]; then
    nix build '.#devShells.x86_64-linux.default' -o .gcroot
  fi
  nix develop -c true"

say "restart service"
ssh "$ROOT" 'systemctl restart iauthor && sleep 1 && systemctl is-active iauthor'

say "health check $URL"
for _ in $(seq 1 15); do
  code=$(curl -s -o /dev/null -w '%{http_code}' "$URL/login" || true)
  if [ "$code" = "200" ]; then
    echo "healthy (HTTP $code)"
    exit 0
  fi
  sleep 2
done

echo "health check failed after restart" >&2
exit 1