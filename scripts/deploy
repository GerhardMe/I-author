#!/usr/bin/env bash
# Deploy Iauthor: test locally, push the repo to GitHub, then the server
# (a git clone) pulls, installs and builds — everything inside the flake
# shell, so the server hand-installs nothing. Restart + health check.
set -euo pipefail
cd "$(dirname "$0")/.."

SERVER=${IAUTHOR_SERVER:-server}
ROOT=${IAUTHOR_ROOT:-serverRoot}
APP_DIR=${IAUTHOR_APP_DIR:-/home/server/iauthor}
URL=${IAUTHOR_URL:-https://write.gerhard.page}
DOMAIN=${IAUTHOR_DOMAIN:-write.gerhard.page}

say() { printf '\n==> %s\n' "$*"; }

# run pnpm under nix develop when it is not on PATH
run() {
  if command -v pnpm >/dev/null 2>&1; then "$@"; else nix develop -c "$@"; fi
}

say "tests"
run pnpm test

say "push to github (deploy ships commits — a dirty tree is an error)"
if [ -n "$(git status --porcelain)" ]; then
  echo 'working tree is dirty; commit first' >&2
  exit 1
fi
git push origin main

say "pull + install + build on $SERVER:$APP_DIR (previous dist kept until success)"
ssh "$SERVER" "set -e; cd $APP_DIR
  git pull --ff-only
  nix develop -c pnpm install --frozen-lockfile
  rm -rf dist.old
  if [ -d dist ]; then mv dist dist.old; fi
  if IAUTHOR_DOMAINS=$DOMAIN nix develop -c pnpm build; then
    rm -rf dist.old
  else
    echo 'server build failed; restoring previous dist' >&2
    if [ -d dist ]; then rm -rf dist; fi
    if [ -d dist.old ]; then mv dist.old dist; fi
    exit 1
  fi"

say "restart service"
ssh "$ROOT" 'systemctl restart iauthor && sleep 1 && systemctl is-active iauthor'

say "health check $URL"
for _ in $(seq 1 15); do
  code=$(curl -s -o /dev/null -w '%{http_code}' "$URL/login" || true)
  if [ "$code" = "200" ]; then
    echo "healthy (HTTP $code)"
    exit 0
  fi
  sleep 2
done

echo "health check failed after restart" >&2
exit 1
